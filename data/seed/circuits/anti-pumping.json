  "scenarios": [
    {
      "title": "带防跳：合于故障",
      "steps": [
        {
          "action": "operate",
          "target": "KOP",
          "to": "closed",
          "explain": "模拟线路上有永久性故障：断路器一合上，保护就会动作，跳闸出口接点一直闭合。"
        },
        {
          "action": "operate",
          "target": "SA_close",
          "to": "closed",
          "explain": "运行人员手合，并且一直按住把手（合闸命令保持）。"
        },
        {
          "action": "run",
          "explain": "断路器合上 → 跳闸回路接通，TQ 动作把断路器跳开；同时 TBJ 电流线圈流过跳闸电流启动。TBJ 常开接点闭合，电压线圈经合闸命令自保持；常闭接点断开合闸回路。断路器停在分位，不再重合。"
        },
        {
          "action": "operate",
          "target": "SA_close",
          "to": "open",
          "explain": "松开把手，合闸命令消失。"
        },
        {
          "action": "run",
          "explain": "TBJ 电压线圈失电，TBJ 返回，回路恢复到可以再次合闸的状态。"
        }
      ]
    },
    {
      "title": "去掉防跳：跳跃现象",
      "steps": [
        {
          "action": "operate",
          "target": "NOPUMP",
          "to": "closed",
          "explain": "用演示短接线把 TBJ 常闭接点短接，相当于没有防跳。"
        },
        {
          "action": "operate",
          "target": "KOP",
          "to": "closed",
          "explain": "同样模拟永久性故障，跳闸出口接点一直闭合。"
        },
        {
          "action": "operate",
          "target": "SA_close",
          "to": "closed",
          "explain": "手合并保持把手。"
        },
        {
          "action": "run",
          "explain": "断路器合上 → 被跳开 → 合闸回路又通 → 再合上 → 再跳开……这就是“跳跃”。引擎检测到状态循环，报告振荡。"
        }
      ]
    }
