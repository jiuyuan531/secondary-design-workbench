  "scenarios": [
    {
      "title": "正常运行（合位）",
      "steps": [
        {
          "action": "run",
          "explain": "断路器在合位：HWJ 经常开辅助接点和 TQ 构成回路，HWJ 动作（高阻线圈），TQ 不动作；TWJ 所在回路被常闭辅助接点断开，TWJ 返回。HWJ 常闭断开，断线信号不亮。"
        }
      ]
    },
    {
      "title": "控制电源消失",
      "steps": [
        {
          "action": "operate",
          "target": "F_QK",
          "to": "active",
          "explain": "注入故障：控制电源空开处断线。"
        },
        {
          "action": "run",
          "explain": "TWJ、HWJ 都失电返回，两个常闭接点都闭合，“控制回路断线”信号亮。"
        },
        {
          "action": "operate",
          "target": "F_QK",
          "to": "inactive",
          "explain": "恢复控制电源。"
        },
        {
          "action": "run",
          "explain": "HWJ 重新动作，信号熄灭。"
        }
      ]
    },
    {
      "title": "跳闸线圈断线",
      "steps": [
        {
          "action": "operate",
          "target": "F_TQ",
          "to": "active",
          "explain": "注入故障：跳闸线圈断线。合位时 HWJ 正是靠跳闸线圈构成回路的。"
        },
        {
          "action": "run",
          "explain": "HWJ 失电返回；断路器在合位，TWJ 本来就返回，于是两个常闭都闭合，发“控制回路断线”信号——断路器此时已经跳不开了。"
        }
      ]
    }
