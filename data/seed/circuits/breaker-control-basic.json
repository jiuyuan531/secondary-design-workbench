  "scenarios": [
    {
      "title": "手动合闸",
      "steps": [
        {
          "action": "operate",
          "target": "SA_close",
          "to": "closed",
          "explain": "把操作把手打到合闸位置，合闸接点闭合。TWJ 线圈两端被这个接点短接。"
        },
        {
          "action": "tick",
          "explain": "合闸回路 +KM → SA合闸接点 → 断路器常闭 → HQ → -KM 导通，路径上没有其他高阻元件，HQ 动作；断路器开始合闸。"
        },
        {
          "action": "run",
          "explain": "断路器合上后，常闭辅助接点断开，合闸回路被自动切断，HQ 失电——这就是合闸线圈不会长期通电烧毁的原因。同时跳闸回路经常开辅助接点接通，HWJ 动作，红灯亮。"
        },
        {
          "action": "operate",
          "target": "SA_close",
          "to": "open",
          "explain": "松开把手，自动复位，合闸接点断开。"
        },
        {
          "action": "run",
          "explain": "状态保持合位：HWJ 经常开辅助接点和 TQ 构成回路，HWJ 是高阻线圈所以动作，TQ 因路径上串着高阻的 HWJ 而不动作，同时监视着跳闸回路是否完好。"
        }
      ]
    },
    {
      "title": "保护跳闸",
      "steps": [
        {
          "action": "operate",
          "target": "SA_close",
          "to": "closed",
          "explain": "先合上断路器。"
        },
        {
          "action": "run",
          "explain": "断路器合上。"
        },
        {
          "action": "operate",
          "target": "SA_close",
          "to": "open",
          "explain": "把手复位。"
        },
        {
          "action": "operate",
          "target": "KOP",
          "to": "closed",
          "explain": "保护动作，跳闸出口接点闭合，HWJ 线圈被短接。"
        },
        {
          "action": "run",
          "explain": "TQ 动作，断路器跳开；常开辅助接点断开跳闸回路，TQ 失电。合闸回路经常闭辅助接点接通，TWJ 动作，绿灯亮。"
        },
        {
          "action": "operate",
          "target": "KOP",
          "to": "open",
          "explain": "故障切除后保护返回。"
        },
        {
          "action": "run",
          "explain": "保持分位。"
        }
      ]
    }
  ]
